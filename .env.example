POSTGRES_DB=iceberg_ops
POSTGRES_USER=iceberg_ops
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
API_PORT=8088
WEB_PORT=3000
ENVIRONMENT=demo
DEMO_DATA=true
WEB_CONCURRENCY=1
PLAYGROUND_ENABLED=true
PLAYGROUND_TIMEOUT_SECONDS=120
PLAYGROUND_RUNNER_TOKEN=local-playground-token
OPERATION_WORKER_POLL_SECONDS=2
OPERATION_WORKER_TIMEOUT_SECONDS=1800

# Production Spark execution through Apache Livy. Start with: docker compose --profile livy up -d
SPARK_ENGINE_NAME=spark-production
LIVY_URL=http://livy.internal:8998
LIVY_JOB_FILE=hdfs:///apps/iceberg-ops/iceberg_maintenance.py
LIVY_POLL_SECONDS=5
LIVY_REQUEST_TIMEOUT_SECONDS=30
LIVY_VERIFY_TLS=true
LIVY_CA_BUNDLE=
LIVY_USERNAME=
LIVY_PASSWORD=
LIVY_BEARER_TOKEN=
LIVY_PROXY_USER=
LIVY_QUEUE=
LIVY_DRIVER_MEMORY=2g
LIVY_EXECUTOR_MEMORY=4g
LIVY_NUM_EXECUTORS=4
LIVY_CONF_JSON={"spark.sql.extensions":"org.apache.iceberg.spark.extensions.IcebergSparkSessionExtensions","spark.sql.catalog.production":"org.apache.iceberg.spark.SparkCatalog","spark.sql.catalog.production.type":"rest","spark.sql.catalog.production.uri":"http://rest-catalog:8181"}
HDFS_UI_PORT=9870
SPARK_MASTER_UI_PORT=19090
SPARK_WORKER_UI_PORT=19091
PLAYGROUND_LIVY_PORT=18998
PLAYGROUND_RUNNER_PORT=8090
