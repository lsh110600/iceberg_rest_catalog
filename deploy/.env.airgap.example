# Image tags in the transfer bundle. Keep APP_VERSION aligned with the bundle name.
APP_VERSION=0.1.0
IMAGE_REPOSITORY=iceberg-ops

POSTGRES_DB=iceberg_ops
POSTGRES_USER=iceberg_ops
# Use URL-safe characters because this value is embedded in DATABASE_URL.
POSTGRES_PASSWORD=REPLACE_WITH_A_RANDOM_URL_SAFE_PASSWORD

ENVIRONMENT=production
DEMO_DATA=false
WEB_CONCURRENCY=2

# Keep 127.0.0.1 when an internal reverse proxy terminates TLS on this host.
# Set an approved management-network address only when direct access is required.
BIND_ADDRESS=127.0.0.1
API_PORT=8088
WEB_PORT=3000
PUBLIC_ORIGIN=http://localhost:3000

# Playground is optional because Hadoop/Spark substantially increase bundle size.
# Set true only when the bundle was built with INCLUDE_PLAYGROUND=true.
PLAYGROUND_ENABLED=false
PLAYGROUND_TIMEOUT_SECONDS=120
PLAYGROUND_RUNNER_TOKEN=REPLACE_WITH_A_RANDOM_RUNNER_TOKEN
OPERATION_WORKER_POLL_SECONDS=2
OPERATION_WORKER_TIMEOUT_SECONDS=1800

# Production Spark jobs are submitted to an existing internal Livy service.
# Upload spark-jobs/iceberg_maintenance.py to LIVY_JOB_FILE before enabling the livy profile.
SPARK_ENGINE_NAME=spark-production
LIVY_URL=https://livy.internal.example:8998
LIVY_JOB_FILE=hdfs:///apps/iceberg-ops/iceberg_maintenance.py
LIVY_POLL_SECONDS=5
LIVY_REQUEST_TIMEOUT_SECONDS=30
LIVY_VERIFY_TLS=true
LIVY_CA_BUNDLE=
LIVY_USERNAME=
LIVY_PASSWORD=
LIVY_BEARER_TOKEN=
LIVY_PROXY_USER=iceberg-ops
LIVY_QUEUE=iceberg-maintenance
LIVY_DRIVER_MEMORY=2g
LIVY_EXECUTOR_MEMORY=4g
LIVY_NUM_EXECUTORS=4
LIVY_CONF_JSON={"spark.sql.extensions":"org.apache.iceberg.spark.extensions.IcebergSparkSessionExtensions","spark.sql.catalog.production":"org.apache.iceberg.spark.SparkCatalog","spark.sql.catalog.production.type":"rest","spark.sql.catalog.production.uri":"https://catalog.internal.example:8181"}
HDFS_UI_PORT=9870
SPARK_MASTER_UI_PORT=19090
SPARK_WORKER_UI_PORT=19091
PLAYGROUND_LIVY_PORT=18998
PLAYGROUND_RUNNER_PORT=8090
